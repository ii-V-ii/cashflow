# ── Vercel 배포에 필요한 런타임 env 4종: DATABASE_URL, NEXT_PUBLIC_SUPABASE_URL,
# ── NEXT_PUBLIC_SUPABASE_ANON_KEY, OWNER_EMAIL (NEXT_PUBLIC_*는 빌드 타임에 인라인됨)

# Supabase transaction-mode pooler (포트 6543) — 앱 런타임용 (ARCHITECTURE.md §8)
# 프로덕션 형식: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 로컬: supabase start 후 postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase 프로젝트 (로컬: supabase start 출력값 / 프로덕션: 프로젝트 설정 → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 소유자 이메일 — guarded()가 세션 이메일과 대조한다 (미설정 시 전 API 요청 거부, fail-closed)
OWNER_EMAIL=you@example.com

# 로컬 E2E 시드 전용 (앱 런타임은 사용하지 않음 — playwright.config.ts 참조)
# 프로덕션(Vercel)에는 설정하지 않는다. 클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
