# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database
data/*.db
data/*.db-journal
data/*.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts

# serwist (generated service worker)
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# supabase local
supabase/.temp
supabase/.branches

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# local db backup dumps
cashflow-backup-*.sql
